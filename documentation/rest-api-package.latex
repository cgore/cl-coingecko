See \texttt{coingecko.restclient} in the repository root for
\texttt{curl}-style examples of the same paths.

\section{Onchain}

These functions are defined in \texttt{source/onchain.lisp} but exported
from \texttt{coingecko/rest-api}.  They talk to the same v3 host when you
have a key.  Path parameters that are addresses may be a string or a
list (joined with commas).

\small
\begin{longtable}{p{0.48\textwidth}p{0.46\textwidth}}
\toprule
Function & Path \\
\midrule
\endhead
\texttt{get-onchain-token-price} & \texttt{/onchain/simple/networks/\ldots/token\_price/\ldots} \\
\texttt{get-onchain-pool} & \texttt{/onchain/networks/\{network\}/pools/\{address\}} \\
\texttt{get-onchain-pools} & \texttt{\ldots/pools/multi/\{addresses\}} \\
\texttt{get-onchain-pool-info} & \texttt{\ldots/pools/\{pool\_address\}/info} \\
\texttt{get-onchain-top-pools} & \texttt{/onchain/networks/\{network\}/pools} \\
\texttt{get-onchain-top-pools-by-dex} & \texttt{\ldots/dexes/\{dex\}/pools} \\
\texttt{get-onchain-top-pools-by-token} & \texttt{\ldots/tokens/\{token\}/pools} \\
\texttt{get-onchain-pools-megafilter} & \texttt{/onchain/pools/megafilter} \\
\texttt{get-onchain-new-pools} & \texttt{/onchain/networks/new\_pools} \\
\texttt{get-onchain-new-pools-by-network} & \texttt{\ldots/\{network\}/new\_pools} \\
\texttt{get-onchain-trending-pools} & \texttt{/onchain/networks/trending\_pools} \\
\texttt{get-onchain-trending-pools-by-network} & \texttt{\ldots/\{network\}/trending\_pools} \\
\texttt{get-onchain-trending-search-pools} & \texttt{/onchain/pools/trending\_search} \\
\texttt{get-onchain-token} & \texttt{/onchain/networks/\{network\}/tokens/\{address\}} \\
\texttt{get-onchain-tokens} & \texttt{\ldots/tokens/multi/\{addresses\}} \\
\texttt{get-onchain-token-info} & \texttt{\ldots/tokens/\{address\}/info} \\
\texttt{get-onchain-tokens-recently-updated} & \texttt{/onchain/tokens/info\_recently\_updated} \\
\texttt{get-onchain-pool-ohlcv} & \texttt{\ldots/pools/\ldots/ohlcv/\{timeframe\}} \\
\texttt{get-onchain-token-ohlcv} & \texttt{\ldots/tokens/\ldots/ohlcv/\{timeframe\}} \\
