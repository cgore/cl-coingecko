\texttt{get-onchain-networks} & \texttt{/onchain/networks} \\
\texttt{get-onchain-dexes} & \texttt{/onchain/networks/\{network\}/dexes} \\
\texttt{get-onchain-search-pools} & \texttt{/onchain/search/pools} \\
\bottomrule
